{
  "name": "smart-handwritten-note-understanding-service",
  "version": "1.0.0",
  "description": "AI-Driven Handwritten Note Understanding and Learning Gap Detection Service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "eval:benchmarks": "ts-node src/scripts/run-research-benchmarks.ts",
    "eval:dashboard": "ts-node src/scripts/generate-eval-dashboard.ts",
    "test": "node --test -r ts-node/register src/config/validateConfig.test.ts src/curriculum/identity.test.ts src/pipeline/conceptPrediction.test.ts src/pipeline/stages/10-qualityVerification.test.ts src/annotations/contract.test.ts src/ml/conceptClassifier.test.ts src/services/ocrService.test.ts src/services/textbookFilename.test.ts",
    "security:secrets": "ts-node src/scripts/check-committed-secrets.ts",
    "annotations:export": "ts-node src/scripts/export-annotation-candidates.ts",
    "annotations:import": "ts-node src/scripts/import-reviewed-annotations.ts",
    "annotations:stats": "ts-node src/scripts/annotation-stats.ts",
    "annotations:readiness": "ts-node src/scripts/annotation-readiness.ts",
    "annotations:reprocess": "ts-node src/scripts/reprocess-legacy-notes.ts",
    "annotations:ingest-notes": "ts-node src/scripts/ingest-offline-note-batch.ts",
    "annotations:release": "ts-node src/scripts/release-annotation-dataset.ts",
    "kb:verify": "ts-node src/scripts/verify-knowledge-base-coverage.ts",
    "model:train": "ts-node src/scripts/train-concept-classifier.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Interactive-Digital-Learning-Platform/Smart-HandWritten-Note-Understanding-Service.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Interactive-Digital-Learning-Platform/Smart-HandWritten-Note-Understanding-Service/issues"
  },
  "homepage": "https://github.com/Interactive-Digital-Learning-Platform/Smart-HandWritten-Note-Understanding-Service#readme",
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@types/pg": "^8.23.1",
    "axios": "^1.16.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "groq-sdk": "^1.1.2",
    "helmet": "^8.1.0",
    "mongoose": "^9.6.1",
    "multer": "^2.1.1",
    "pg": "^8.23.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
