# Destination configuration only. Replace placeholders privately; never commit keys.
NOTES_IMAGE=smart-notes:science-v35-history-v62-r2-20261019
NODE_ENV=production
PORT=8004
MONGODB_URI=mongodb+srv://<username>:<password>@<mongo-host>/<notes-database>
CURRICULUM_DB_URL=postgresql://<username>:<password>@<postgres-host>/<ingestion-database>?sslmode=require
QDRANT_DB_URL=https://<qdrant-host>:6333
QDRANT_API_KEY=<qdrant-key>
QDRANT_COLLECTION=pdf_knowledge_base_v2
# Must match the destination ingestion writer; the verified local writer uses 1.
QDRANT_PAYLOAD_PAGE_BASE=1
GROQ_API_KEY=<groq-key>
GROQ_MODEL=openai/gpt-oss-120b
GROQ_OCR_MODEL=qwen/qwen3.8-27b
CLERK_ISSUER_URL=https://<clerk-instance>.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=https://<deployed-frontend-origin>
NOTE_IMAGE_STORAGE=r2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=<existing-notes-bucket>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
ENGLISH_COVERAGE_SUGGESTIONS_ENABLED=true
HISTORY_COVERAGE_REVIEW_ENABLED=true
ICT_COVERAGE_REVIEW_ENABLED=false
ANNOTATION_REVIEW_ENABLED=false
ENGLISH_COVERAGE_REVIEW_ENABLED=false
COVERAGE_BUNDLE_DIR=/app/coverage-runtime
COVERAGE_PYTHON=/opt/coverage-python/bin/python
ENGLISH_COVERAGE_PYTHON=/opt/coverage-python/bin/python
HISTORY_COVERAGE_PYTHON=/opt/coverage-python/bin/python
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DIMENSION=768
EMBEDDING_PROVIDER=local-transformers-js
EMBEDDING_CACHE_DIR=/app/.cache/embeddings
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=10
# Optional real speech provider key; omit when using transcript fallback.
# ELEVENLABS_API_KEY=
