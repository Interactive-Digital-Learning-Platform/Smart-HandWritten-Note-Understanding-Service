# Copy to .env.production on the destination. Never commit or distribute secrets.
# The application needs the existing databases/ingested textbook collection.
MONGODB_URI=mongodb+srv://<username>:<password>@<host>/smart-notes
CURRICULUM_DB_URL=postgresql://<username>:<password>@<host>/<database>?sslmode=require
QDRANT_DB_URL=http://host.docker.internal:6333
QDRANT_COLLECTION=pdf_knowledge_base
GROQ_API_KEY=<groq-key>
GROQ_MODEL=openai/gpt-oss-120b
GROQ_OCR_MODEL=qwen/qwen3.8-27b
CLERK_ISSUER_URL=https://<your-clerk-instance>.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=https://<your-app-domain>
# Optional: set a real key for generated speech. Omit to use transcript fallback.
# ELEVENLABS_API_KEY=<elevenlabs-key>
