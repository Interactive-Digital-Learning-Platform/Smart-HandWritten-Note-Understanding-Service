  "definitions": [
    {
      "term": "Photosynthesis",
      "definition": "The process by which green plants use light energy, carbon dioxide, and water to produce glucose and oxygen.",
      "conceptId": "bio-g10-photo-002"
    },
    {
      "term": "Chlorophyll",
      "definition": "The green pigment found in chloroplasts that absorbs light energy for photosynthesis.",
      "conceptId": "bio-g10-photo-001"
    },
    {
      "term": "Chloroplast",
      "definition": "A membrane-bound organelle in plant cells where photosynthesis takes place, containing chlorophyll.",
      "conceptId": "bio-g10-photo-008"
    },
    {
      "term": "ATP",
      "definition": "Adenosine triphosphate — the energy currency molecule produced during the light reaction and used in the Calvin Cycle.",
      "conceptId": "bio-g10-photo-010"
    },
    {
      "term": "NADPH",
      "definition": "A hydrogen/electron carrier molecule produced in the light reaction and used to reduce CO₂ in the Calvin Cycle.",
      "conceptId": "bio-g10-photo-011"
    },
    {
      "term": "Calvin Cycle",
      "definition": "The light-independent stage of photosynthesis occurring in the stroma, where CO₂ is fixed into glucose using ATP and NADPH.",
      "conceptId": "bio-g10-photo-013"
    },
    {
      "term": "Photolysis",
      "definition": "The splitting of water molecules by light energy during the light reaction, producing oxygen, hydrogen ions, and electrons.",
      "conceptId": "bio-g10-photo-012"
    },
    {
      "term": "Carbon Fixation",
      "definition": "The process in the Calvin Cycle where CO₂ is incorporated into an organic molecule by the enzyme RuBisCO.",
      "conceptId": "bio-g10-photo-014"
    },
    {
      "term": "Limiting Factor",
      "definition": "An environmental factor (light, CO₂, temperature) that restricts the rate of photosynthesis when in short supply.",
      "conceptId": "bio-g10-photo-016"
    }
  ],
  "formulae": [
    "6CO₂ + 6H₂O → C₆H₁₂O₆ + 6O₂ (in the presence of light energy and chlorophyll)",
    "Carbon Dioxide + Water → Glucose + Oxygen"
  ],
