  "definitions": [
    {
      "term": "Cellular Respiration",
      "definition": "The process by which cells break down glucose in the presence or absence of oxygen to release energy in the form of ATP.",
      "conceptId": "bio-g10-resp-001"
    },
    {
      "term": "Aerobic Respiration",
      "definition": "Respiration that occurs in the presence of oxygen, completely breaking down glucose into CO₂ and H₂O, producing 38 ATP.",
      "conceptId": "bio-g10-resp-003"
    },
    {
      "term": "Anaerobic Respiration",
      "definition": "Respiration that occurs without oxygen, incompletely breaking down glucose and producing only 2 ATP.",
      "conceptId": "bio-g10-resp-009"
    },
    {
      "term": "Glycolysis",
      "definition": "The first stage of respiration occurring in the cytoplasm, where glucose is split into two pyruvate molecules, producing 2 ATP.",
      "conceptId": "bio-g10-resp-006"
    },
    {
      "term": "Krebs Cycle",
      "definition": "The second stage of aerobic respiration occurring in the mitochondrial matrix, where pyruvate derivatives are further oxidized.",
      "conceptId": "bio-g10-resp-007"
    },
    {
      "term": "Mitochondria",
      "definition": "A double-membrane organelle known as the 'powerhouse of the cell' where aerobic respiration (Krebs cycle and ETC) takes place.",
      "conceptId": "bio-g10-resp-013"
    },
    {
      "term": "ATP",
      "definition": "Adenosine triphosphate — the universal energy currency of cells, produced during respiration and used for cellular activities.",
      "conceptId": "bio-g10-resp-014"
    },
    {
      "term": "Lactic Acid Fermentation",
      "definition": "Anaerobic respiration in animal muscle cells where glucose is converted to lactic acid, causing muscle fatigue.",
      "conceptId": "bio-g10-resp-010"
    }
  ],
  "formulae": [
    "C₆H₁₂O₆ + 6O₂ → 6CO₂ + 6H₂O + 38 ATP (aerobic respiration)",
    "Glucose + Oxygen → Carbon Dioxide + Water + Energy",
    "C₆H₁₂O₆ → 2C₂H₅OH + 2CO₂ + 2 ATP (alcoholic fermentation)",
    "C₆H₁₂O₆ → 2C₃H₆O₃ + 2 ATP (lactic acid fermentation)"
  ],
