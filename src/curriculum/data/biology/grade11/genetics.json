  "definitions": [
    {
      "term": "Gene",
      "definition": "A segment of DNA on a chromosome that codes for a specific protein and controls a particular inherited characteristic.",
      "conceptId": "bio-g11-gen-001"
    },
    {
      "term": "Allele",
      "definition": "An alternative form of a gene that occupies the same locus on a chromosome.",
      "conceptId": "bio-g11-gen-002"
    },
    {
      "term": "Genotype",
      "definition": "The genetic constitution of an organism — the combination of alleles it possesses.",
      "conceptId": "bio-g11-gen-003"
    },
    {
      "term": "Phenotype",
      "definition": "The observable physical characteristics of an organism, resulting from the interaction of its genotype and environment.",
      "conceptId": "bio-g11-gen-003"
    },
    {
      "term": "Law of Segregation",
      "definition": "During gamete formation, the two alleles for each gene separate (segregate) so that each gamete receives only one allele.",
      "conceptId": "bio-g11-gen-005"
    },
    {
      "term": "Co-dominance",
      "definition": "A condition where both alleles in a heterozygote are fully expressed simultaneously in the phenotype.",
      "conceptId": "bio-g11-gen-009"
    },
    {
      "term": "Mutation",
      "definition": "A permanent change in the DNA sequence of a gene or chromosome, which may be inherited.",
      "conceptId": "bio-g11-gen-015"
    }
  ],
  "formulae": [
