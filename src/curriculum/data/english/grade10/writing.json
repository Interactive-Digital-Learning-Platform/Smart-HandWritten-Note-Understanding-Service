  "definitions": [
    {
      "term": "Formal Letter",
      "definition": "A letter written in a professional, polite tone following a strict format, used for official or business purposes.",
      "conceptId": "eng-g10-writ-001"
    },
    {
      "term": "Informal Letter",
      "definition": "A friendly letter written in a casual tone to someone you know personally, with a relaxed format.",
      "conceptId": "eng-g10-writ-003"
    },
    {
      "term": "Topic Sentence",
      "definition": "The sentence that states the main idea of a paragraph, usually placed at the beginning.",
      "conceptId": "eng-g10-writ-008"
    },
    {
      "term": "Discourse Markers",
      "definition": "Words or phrases used to connect, organize, or sequence ideas in writing (e.g., 'however', 'furthermore', 'in conclusion').",
      "conceptId": "eng-g10-writ-010"
    },
    {
      "term": "Register",
      "definition": "The level of formality used in language, adjusted according to the audience and purpose of writing.",
      "conceptId": "eng-g10-writ-002"
    }
  ],
  "formulae": [
    "Formal Letter structure: Sender Address → Date → Receiver Address → Salutation → Subject → Body → Closing → Signature",
    "Essay structure: Introduction (hook + thesis) → Body (3 paragraphs) → Conclusion (summary + final thought)",
    "Paragraph structure: Topic Sentence → Supporting Sentences → Concluding Sentence"
