  "definitions": [
    {
      "term": "Noun",
      "definition": "A word that names a person, place, thing, or idea.",
      "conceptId": "eng-g10-gram-001"
    },
    {
      "term": "Verb",
      "definition": "A word that expresses an action, state, or occurrence.",
      "conceptId": "eng-g10-gram-002"
    },
    {
      "term": "Adjective",
      "definition": "A word that describes or modifies a noun or pronoun.",
      "conceptId": "eng-g10-gram-003"
    },
    {
      "term": "Adverb",
      "definition": "A word that modifies a verb, adjective, or another adverb, often indicating how, when, where, or to what extent.",
      "conceptId": "eng-g10-gram-004"
    },
    {
      "term": "Active Voice",
      "definition": "A sentence construction where the subject performs the action: 'The cat chased the mouse.'",
      "conceptId": "eng-g10-gram-012"
    },
    {
      "term": "Passive Voice",
      "definition": "A sentence construction where the subject receives the action: 'The mouse was chased by the cat.'",
      "conceptId": "eng-g10-gram-012"
    },
    {
      "term": "Subject-Verb Agreement",
      "definition": "The grammatical rule that a verb must agree in number with its subject. Singular subject → singular verb; plural subject → plural verb.",
      "conceptId": "eng-g10-gram-017"
    }
  ],
  "formulae": [
    "Passive Voice formula: Object + is/was/are/were + past participle + (by + subject)",
    "Present Perfect: Subject + have/has + past participle",
    "Past Perfect: Subject + had + past participle",
    "Comparative adjective: adjective + -er / more + adjective",
    "Superlative adjective: the + adjective + -est / the most + adjective"
  ],
