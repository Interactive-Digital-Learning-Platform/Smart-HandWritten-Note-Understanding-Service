  "definitions": [
    {
      "term": "Triangle",
      "definition": "A polygon with three sides and three angles whose interior angles sum to 180°.",
      "conceptId": "math-g10-geo-001"
    },
    {
      "term": "Pythagoras Theorem",
      "definition": "In a right-angled triangle, the square of the hypotenuse equals the sum of the squares of the other two sides: a² + b² = c².",
      "conceptId": "math-g10-geo-004"
    },
    {
      "term": "Congruent Triangles",
      "definition": "Triangles that have exactly the same shape and size — all corresponding sides and angles are equal.",
      "conceptId": "math-g10-geo-006"
    },
    {
      "term": "Similar Triangles",
      "definition": "Triangles that have the same shape but different sizes — corresponding angles are equal and corresponding sides are proportional.",
      "conceptId": "math-g10-geo-007"
    },
    {
      "term": "Circumference",
      "definition": "The distance around the boundary of a circle, calculated as C = 2πr or C = πd.",
      "conceptId": "math-g10-geo-012"
    }
  ],
  "formulae": [
    "a² + b² = c² (Pythagoras Theorem)",
    "Area of Triangle = ½ × base × height",
    "Circumference = 2πr = πd",
    "Area of Circle = πr²",
    "Sum of interior angles of a triangle = 180°",
    "Exterior angle = sum of two remote interior angles"
  ],
