  "definitions": [
    {
      "term": "Algebraic Expression",
      "definition": "A mathematical phrase containing numbers, variables, and operations but no equals sign.",
      "conceptId": "math-g10-alg-001"
    },
    {
      "term": "Linear Equation",
      "definition": "An equation of the first degree (highest power of the variable is 1) in the form ax + b = 0.",
      "conceptId": "math-g10-alg-007"
    },
    {
      "term": "Quadratic Equation",
      "definition": "An equation of the second degree (highest power of the variable is 2) in the form ax² + bx + c = 0, where a ≠ 0.",
      "conceptId": "math-g10-alg-012"
    },
    {
      "term": "Factorization",
      "definition": "The process of expressing an algebraic expression as a product of its factors.",
      "conceptId": "math-g10-alg-004"
    },
    {
      "term": "Simultaneous Equations",
      "definition": "A set of two or more equations with the same variables that are solved together to find values satisfying all equations.",
      "conceptId": "math-g10-alg-009"
    }
  ],
  "formulae": [
    "a² - b² = (a + b)(a - b) (Difference of Squares)",
    "x = (-b ± √(b² - 4ac)) / 2a (Quadratic Formula)",
    "aᵐ × aⁿ = aᵐ⁺ⁿ (Index Law - Multiplication)",
    "aᵐ ÷ aⁿ = aᵐ⁻ⁿ (Index Law - Division)",
    "(aᵐ)ⁿ = aᵐⁿ (Index Law - Power of Power)",
    "a⁰ = 1 (Zero Index)",
    "a⁻ⁿ = 1/aⁿ (Negative Index)"
  ],
