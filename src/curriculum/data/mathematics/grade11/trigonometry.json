  "definitions": [
    {
      "term": "Sine",
      "definition": "In a right-angled triangle, sin θ = opposite / hypotenuse.",
      "conceptId": "math-g11-trig-001"
    },
    {
      "term": "Cosine",
      "definition": "In a right-angled triangle, cos θ = adjacent / hypotenuse.",
      "conceptId": "math-g11-trig-002"
    },
    {
      "term": "Tangent",
      "definition": "In a right-angled triangle, tan θ = opposite / adjacent.",
      "conceptId": "math-g11-trig-003"
    },
    {
      "term": "Angle of Elevation",
      "definition": "The angle measured upward from the horizontal to a line of sight to an object above.",
      "conceptId": "math-g11-trig-006"
    },
    {
      "term": "Angle of Depression",
      "definition": "The angle measured downward from the horizontal to a line of sight to an object below.",
      "conceptId": "math-g11-trig-007"
    }
  ],
  "formulae": [
    "sin θ = opposite / hypotenuse",
    "cos θ = adjacent / hypotenuse",
    "tan θ = opposite / adjacent",
    "Sine Rule: a/sin A = b/sin B = c/sin C",
    "Cosine Rule: a² = b² + c² − 2bc cos A",
    "Area of Triangle = ½ × a × b × sin C",
    "sin 30° = ½, cos 30° = √3/2, tan 30° = 1/√3",
    "sin 45° = 1/√2, cos 45° = 1/√2, tan 45° = 1",
    "sin 60° = √3/2, cos 60° = ½, tan 60° = √3"
  ],
