  "definitions": [
    {
      "term": "Organic Chemistry",
      "definition": "The branch of chemistry concerned with the study of carbon-containing compounds and their reactions.",
      "conceptId": "chem-g11-org-001"
    },
    {
      "term": "Homologous Series",
      "definition": "A series of organic compounds with the same general formula and functional group, differing by a CH₂ unit, with gradually changing properties.",
      "conceptId": "chem-g11-org-003"
    },
    {
      "term": "Alkane",
      "definition": "A saturated hydrocarbon with only single C-C bonds. General formula: CₙH₂ₙ₊₂.",
      "conceptId": "chem-g11-org-004"
    },
    {
      "term": "Alkene",
      "definition": "An unsaturated hydrocarbon containing at least one C=C double bond. General formula: CₙH₂ₙ.",
      "conceptId": "chem-g11-org-006"
    },
    {
      "term": "Isomers",
      "definition": "Compounds with the same molecular formula but different structural arrangements of atoms.",
      "conceptId": "chem-g11-org-008"
    },
    {
      "term": "Esterification",
      "definition": "The reaction between a carboxylic acid and an alcohol (with acid catalyst) to form an ester and water.",
      "conceptId": "chem-g11-org-011"
    }
  ],
  "formulae": [
    "Alkane general formula: CₙH₂ₙ₊₂",
