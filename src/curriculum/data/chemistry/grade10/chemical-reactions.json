  "definitions": [
    {
      "term": "Chemical Reaction",
      "definition": "A process in which one or more substances (reactants) are converted into different substances (products) through bond breaking and forming.",
      "conceptId": "chem-g10-cr-001"
    },
    {
      "term": "Balanced Chemical Equation",
      "definition": "A chemical equation in which the number of atoms of each element is equal on both sides, following the law of conservation of mass.",
      "conceptId": "chem-g10-cr-004"
    },
    {
      "term": "Neutralization",
      "definition": "A reaction between an acid and a base to produce salt and water. Acid + Base → Salt + Water.",
      "conceptId": "chem-g10-cr-009"
    },
    {
      "term": "Exothermic Reaction",
      "definition": "A chemical reaction that releases heat energy to the surroundings, causing a rise in temperature.",
      "conceptId": "chem-g10-cr-011"
    },
    {
      "term": "Endothermic Reaction",
      "definition": "A chemical reaction that absorbs heat energy from the surroundings, causing a drop in temperature.",
      "conceptId": "chem-g10-cr-012"
    },
    {
      "term": "Catalyst",
      "definition": "A substance that increases the rate of a chemical reaction by lowering the activation energy, without being consumed.",
      "conceptId": "chem-g10-cr-015"
    }
  ],
  "formulae": [
    "Acid + Base → Salt + Water (Neutralization)",
    "Acid + Metal → Salt + Hydrogen",
    "Acid + Metal Carbonate → Salt + Water + Carbon Dioxide"
  ],
