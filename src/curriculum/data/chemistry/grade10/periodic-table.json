  "definitions": [
    {
      "term": "Periodic Table",
      "definition": "A tabular arrangement of chemical elements organized by increasing atomic number, showing periodic trends in properties.",
      "conceptId": "chem-g10-pt-001"
    },
    {
      "term": "Group",
      "definition": "A vertical column in the periodic table containing elements with the same number of valence electrons and similar chemical properties.",
      "conceptId": "chem-g10-pt-003"
    },
    {
      "term": "Period",
      "definition": "A horizontal row in the periodic table containing elements with the same number of electron shells.",
      "conceptId": "chem-g10-pt-004"
    },
    {
      "term": "Valency",
      "definition": "The combining capacity of an element, determined by the number of electrons it can lose, gain, or share to complete its outer shell.",
      "conceptId": "chem-g10-pt-006"
    },
    {
      "term": "Electronegativity",
      "definition": "The ability of an atom to attract shared electrons in a chemical bond towards itself.",
      "conceptId": "chem-g10-pt-008"
    }
  ],
