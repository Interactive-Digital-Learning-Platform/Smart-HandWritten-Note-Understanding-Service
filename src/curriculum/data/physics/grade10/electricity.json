  "definitions": [
    {
      "term": "Electric Current",
      "definition": "The rate of flow of electric charge through a conductor, measured in amperes (A). I = Q/t.",
      "conceptId": "phy-g10-elec-001"
    },
    {
      "term": "Voltage (Potential Difference)",
      "definition": "The energy transferred per unit charge between two points in a circuit, measured in volts (V). V = W/Q.",
      "conceptId": "phy-g10-elec-002"
    },
    {
      "term": "Resistance",
      "definition": "The opposition to the flow of electric current in a circuit, measured in ohms (Ω). R = V/I.",
      "conceptId": "phy-g10-elec-003"
    },
    {
      "term": "Ohm's Law",
      "definition": "The current flowing through a conductor is directly proportional to the potential difference across it, provided the temperature remains constant. V = IR.",
      "conceptId": "phy-g10-elec-004"
    },
    {
      "term": "Series Circuit",
      "definition": "A circuit in which components are connected end-to-end in a single path, so the same current flows through all components.",
      "conceptId": "phy-g10-elec-006"
    },
    {
      "term": "Parallel Circuit",
      "definition": "A circuit in which components are connected across the same two points, providing multiple paths for current to flow.",
      "conceptId": "phy-g10-elec-007"
    },
    {
      "term": "Electric Power",
      "definition": "The rate at which electrical energy is transferred or consumed, measured in watts (W). P = VI.",
      "conceptId": "phy-g10-elec-010"
    }
  ],
  "formulae": [
    "V = IR (Ohm's Law)",
    "I = V/R",
    "R = V/I",
    "R_total = R₁ + R₂ + R₃ + ... (Series)",
    "1/R_total = 1/R₁ + 1/R₂ + 1/R₃ + ... (Parallel)",
    "P = VI (Power)",
    "P = I²R",
    "P = V²/R",
    "E = Pt (Electrical Energy)",
    "I = Q/t (Current)"
  ],
