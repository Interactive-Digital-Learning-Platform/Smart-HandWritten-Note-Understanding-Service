  "definitions": [
    {
      "term": "Speed",
      "definition": "The rate of change of distance with time. A scalar quantity measured in m/s. Speed = Distance/Time.",
      "conceptId": "phy-g10-fm-001"
    },
    {
      "term": "Velocity",
      "definition": "The rate of change of displacement with time. A vector quantity (has direction) measured in m/s.",
      "conceptId": "phy-g10-fm-001"
    },
    {
      "term": "Acceleration",
      "definition": "The rate of change of velocity with time, measured in m/s². a = (v − u)/t.",
      "conceptId": "phy-g10-fm-004"
    },
    {
      "term": "Force",
      "definition": "A push or pull that can change an object's state of rest or motion, measured in newtons (N).",
      "conceptId": "phy-g10-fm-009"
    },
    {
      "term": "Newton's First Law",
      "definition": "An object remains at rest or in uniform motion in a straight line unless acted upon by an unbalanced external force (Law of Inertia).",
      "conceptId": "phy-g10-fm-006"
    },
    {
      "term": "Newton's Second Law",
      "definition": "The resultant force on an object is equal to the product of its mass and acceleration. F = ma.",
      "conceptId": "phy-g10-fm-007"
    },
    {
      "term": "Newton's Third Law",
      "definition": "For every action, there is an equal and opposite reaction.",
      "conceptId": "phy-g10-fm-008"
    },
    {
      "term": "Friction",
      "definition": "A resistive force that opposes the relative motion between two surfaces in contact.",
      "conceptId": "phy-g10-fm-010"
    }
  ],
  "formulae": [
    "Speed = Distance / Time",
    "Velocity = Displacement / Time",
    "a = (v − u) / t",
    "v = u + at",
    "s = ut + ½at²",
    "v² = u² + 2as",
    "F = ma (Newton's Second Law)",
    "W = mg (Weight)"
  ],
