  "definitions": [
    {
      "term": "Wave",
      "definition": "A disturbance that transfers energy from one place to another without transferring matter.",
      "conceptId": "phy-g11-wav-001"
    },
    {
      "term": "Amplitude",
      "definition": "The maximum displacement of a particle from its rest position, measured in metres.",
      "conceptId": "phy-g11-wav-001"
    },
    {
      "term": "Wavelength",
      "definition": "The distance between two consecutive points in phase (e.g., crest to crest), measured in metres.",
      "conceptId": "phy-g11-wav-002"
    },
    {
      "term": "Frequency",
      "definition": "The number of complete waves passing a point per second, measured in hertz (Hz).",
      "conceptId": "phy-g11-wav-003"
    },
    {
      "term": "Transverse Wave",
      "definition": "A wave in which particles vibrate perpendicular to the direction of wave travel. Example: light waves.",
      "conceptId": "phy-g11-wav-005"
    },
    {
      "term": "Longitudinal Wave",
      "definition": "A wave in which particles vibrate parallel to the direction of wave travel. Example: sound waves.",
      "conceptId": "phy-g11-wav-006"
    },
    {
      "term": "Resonance",
      "definition": "The large amplitude vibration that occurs when an object is driven at its natural frequency.",
      "conceptId": "phy-g11-wav-015"
    }
  ],
  "formulae": [
    "v = fλ (Wave Speed = Frequency × Wavelength)",
    "f = 1/T (Frequency = 1 / Period)",
    "T = 1/f (Period = 1 / Frequency)",
    "Speed of sound in air ≈ 340 m/s at room temperature"
  ],
