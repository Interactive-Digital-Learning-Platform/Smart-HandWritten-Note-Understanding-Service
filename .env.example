# Smart HandWritten Note Understanding Service

# Copy to .env for local development and supply actual values privately.
# Server
PORT=3001
NODE_ENV=development

# Required for all student Notes APIs and private image/audio files.
# Exact Clerk instance origin from the application's existing Clerk account.
CLERK_ISSUER_URL=https://your-instance.clerk.accounts.dev
# Exact frontend origins; include your Expo web LAN origin for device testing.
CLERK_AUTHORIZED_PARTIES=http://localhost:8082,http://127.0.0.1:8082
# Native session tokens may omit azp; signed tokens still require the issuer above.
# There is no Notes authentication bypass.

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/smart-notes

# Groq AI (Multi-key rotation and failover supported)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_2=your_second_groq_api_key_here
# GROQ_API_KEYS=key1,key2
# Image-capable OCR model, independent of the text analysis model.
GROQ_OCR_MODEL=qwen/qwen3.8-27b

# Hugging Face (TrOCR)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
# Must match the PDF Ingestion service model and its Qdrant vector dimension.
# This service runs the model locally through Transformers.js; the first run
# downloads the model into EMBEDDING_CACHE_DIR.
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_PROVIDER=local-transformers-js
EMBEDDING_DIMENSION=768
EMBEDDING_MAX_TOKENS=8192
EMBEDDING_CACHE_DIR=.cache/embeddings

# File Uploads
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads

# Private Notes images: local until the R2 bucket and server-only keys are ready.
# Do not enable public bucket access. Existing local note images stay local.
NOTE_IMAGE_STORAGE=local
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional expert annotation workspace. Keep disabled until strong secrets and
# approved expert identities are configured. Format: expert-id=access-key.
ANNOTATION_REVIEW_ENABLED=false
EXPERT_ANNOTATION_KEYS=science-expert-01=replace_with_at_least_16_random_characters
ANNOTATION_PSEUDONYM_SECRET=replace_with_at_least_32_random_characters
RESEARCH_CONSENT_VERSION=1.0
ANNOTATION_ALLOWED_SUBJECTS=Science

# Reviewer-assisted English model; also requires the expert-review credentials above.
ENGLISH_COVERAGE_REVIEW_ENABLED=false
# Run the frozen model on supported English uploads and show review-required suggestions.
ENGLISH_COVERAGE_SUGGESTIONS_ENABLED=true
# Optional Python executable; defaults to the service's ml-training/.venv runtime.
# ENGLISH_COVERAGE_PYTHON=/opt/smart-notes/.venv/bin/python

# Optional manual, review-required English History model (no automatic grading).
HISTORY_COVERAGE_REVIEW_ENABLED=false

# ElevenLabs (optional audio)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Curriculum Knowledge Base (PostgreSQL)
CURRICULUM_DB_URL=postgresql://<username>:<password>@<host>/<database>?sslmode=require

# Qdrant Vector Knowledge Base
# Shared v2 deployment: set the HTTPS cluster URL and keep its key secret.
QDRANT_DB_URL=https://<cluster-id>.<region>.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=pdf_knowledge_base_v2
QDRANT_PAYLOAD_PAGE_BASE=1

# Optional ICT checks; disabled in the current Science + History release.
ICT_COVERAGE_REVIEW_ENABLED=false
